+  const at = parseAt(findChild(item, "at"));
+  const effects = parseTextEffects(findChild(item, "effects"));
+  const hidden = effects.hidden || !!findChild(item, "hide");
+  return {
+    type: "text",
+    text: textVal,
+    at,
+    effects,
+    hide: hidden,
+    unit,
+    bodyStyle,
+  };
